<?xml version="1.0" encoding="utf-8"?>
<!--
  Publication autonome (standalone) : un seul LiveChat.exe qui embarque le runtime .NET et WPF,
  aucune installation préalable n'est nécessaire.
    dotnet publish src/LiveChat/LiveChat.csproj -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Les DLL natives de WPF sont intégrées à l'exe (extraites automatiquement au lancement). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
