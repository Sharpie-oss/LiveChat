<Window x:Class="LiveChat.Views.PipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveChat"
        Width="440" Height="320" MinWidth="260" MinHeight="190"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="#01000000"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        Icon="/Assets/LiveChat.ico">
    <!--
        Fond quasi transparent (#01) : une fenêtre « layered » ignore les clics sur les pixels totalement
        transparents ; avec 1 % d'opacité, la bordure de redimensionnement reste utilisable.
        ShowActivated=False : l'apparition de la fenêtre ne vole pas le focus du jeu en cours.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Margin="8">
        <!-- Ombre séparée du contenu : l'effet n'est pas appliqué à la vidéo (meilleures performances). -->
        <Border CornerRadius="12" Background="{StaticResource SurfaceBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.5" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="12" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Barre de titre -->
                <Grid x:Name="TitleBar" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource IdleBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="TitleText" Text="LiveChat" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <Border x:Name="QueueBadge" Visibility="Collapsed" Background="{StaticResource AccentBrush}"
                                CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip="Médias en attente">
                            <TextBlock x:Name="QueueText" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Arrow">
                        <Button x:Name="VolumeButton" Style="{StaticResource IconButtonStyle}" Content="&#xE767;"
                                ToolTip="Volume (ou molette de la souris sur la fenêtre)" Click="VolumeButton_Click" />
                        <Button x:Name="SkipButton" Style="{StaticResource IconButtonStyle}" Content="&#xE893;"
                                ToolTip="Passer au média suivant" Click="SkipButton_Click" IsEnabled="False" />
                        <ToggleButton x:Name="PinToggle" Style="{StaticResource IconButtonStyle}" Content="&#xE718;"
                                      ToolTip="Garder la fenêtre visible même sans média" Click="PinToggle_Click" />
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8BB;" FontSize="10"
                                ToolTip="Masquer (LiveChat reste dans la zone de notification)" Click="HideButton_Click" />
                    </StackPanel>

                    <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}" Placement="Bottom"
                           HorizontalOffset="-120" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="14,10"
                                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="VolumeIcon" Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Slider x:Name="VolumeSlider" Width="130" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                        VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                                <TextBlock x:Name="VolumeText" Width="44" TextAlignment="Right" FontSize="12"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource SubtleBorderBrush}" />

                <!-- Contenu -->
                <Grid Grid.Row="1" Margin="12,10,12,8">
                    <StackPanel x:Name="IdlePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                        <TextBlock x:Name="IdleIcon" Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                   HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Opacity="0.7" />
                        <TextBlock x:Name="IdleText" Text="Connexion à Discord…" Margin="0,12,0,0" FontSize="12.5"
                                   TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <Grid x:Name="MediaPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="AvatarEllipse" Width="22" Height="22" Margin="0,0,8,0" Fill="{StaticResource InputBrush}" />
                            <TextBlock x:Name="AuthorText" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Cadre centré qui prend la taille du média : la légende ne déborde pas sur les bandes noires. -->
                        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                            <Grid x:Name="MediaHost" />

                            <Border x:Name="SpoilerBadge" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#D0000000" CornerRadius="14" Padding="14,5">
                                <TextBlock Text="SPOILER" FontWeight="Bold" FontSize="12" Foreground="White" />
                            </Border>

                            <Border x:Name="CaptionBorder" VerticalAlignment="Top" Visibility="Collapsed" Padding="12,8,12,18">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#B4000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock x:Name="CaptionText" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                           TextWrapping="Wrap" TextAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.9" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                            Background="#E0000000" CornerRadius="14" Padding="14,5" Opacity="0" IsHitTestVisible="False">
                        <TextBlock x:Name="ToastText" Foreground="White" FontSize="12.5" />
                    </Border>
                </Grid>

                <!-- Progression du média en cours -->
                <Rectangle x:Name="ProgressFill" Grid.Row="2" Height="3" Margin="12,0,12,8" RadiusX="1.5" RadiusY="1.5"
                           Fill="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5" Visibility="Hidden">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
        </Border>
    </Grid>
</Window>
